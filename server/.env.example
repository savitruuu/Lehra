# Copy to .env and fill in. .env is gitignored - never commit real values.

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Where the client is served from in development, for the CORS allowlist.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. A local mongod, or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/lehra

# Signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a session lasts.
JWT_EXPIRES_IN=30d

# Set to "true" when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
