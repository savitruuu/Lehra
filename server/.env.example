# Copy to .env and fill in. .env is gitignored - never commit real values.

# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Where the client is served from in development, for the CORS allowlist.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. A local mongod, or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/lehra

# Signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a session lasts.
JWT_EXPIRES_IN=30d

# Set to "true" when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# SMTP for the signup verification email. Any provider works - for Gmail, use
# smtp.gmail.com:587 with an app password (not your account password), from
# https://myaccount.google.com/apppasswords.
# Left unset, OTPs are printed to this process's console instead of emailed,
# so signup is still testable locally without credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lehra <no-reply@lehra.app>
